{
  "name": "internal-tool",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "prepare": "lefthook install",
    "dev": "bun run --parallel dev:api dev:web",
    "dev:web": "bun run --filter '@internal-tool/web' dev",
    "dev:api": "bun run --filter '@internal-tool/api' dev",
    "build:all": "bun run --filter '*' build",
    "lint:all": "bun run --filter '*' lint",
    "typecheck:all": "bun run --filter '*' typecheck",
    "test:all": "bun run --filter '*' test",
    "format": "prettier --write .",
    "format:check:all": "prettier --check .",
    "db:generate": "bun run --filter '@internal-tool/api' db:generate",
    "db:migrate": "bun run --filter '@internal-tool/api' db:migrate",
    "db:studio": "bun run --filter '@internal-tool/api' db:studio"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/bun": "^1.4.3",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
