# Copy to .env for running outside the devcontainer.
# Inside the devcontainer these are already set by .devcontainer/docker-compose.yml.
PORT=8787
WEB_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/internal_tool
# Cloudflare's public always-pass TEST secret. Production requires a real secret.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Use railway only behind Railway's public HTTP edge; see public-protection.md.
CLIENT_IP_SOURCE=socket

# Better Auth. Both are required in production and optional locally.
# Generate a secret with: openssl rand -base64 32. Without one, the API makes a random
# secret at startup, so you'll need to sign in again whenever it restarts.
# BETTER_AUTH_SECRET=
# The web app's origin (browsers reach the API through it). Defaults to this locally.
BETTER_AUTH_URL=http://localhost:3000

# Email service. "console" logs emails instead of sending them (the default outside
# production). Set EMAIL_PROVIDER=resend and RESEND_API_KEY to really send.
EMAIL_PROVIDER=console
# RESEND_API_KEY=
# Defaults to Resend's test sender (onboarding@resend.dev) until cssgunc.org has DNS records.
# EMAIL_FROM=
