# Copy to .env for running outside the devcontainer.
# Inside the devcontainer these are already set by .devcontainer/docker-compose.yml.
PORT=8787
DATABASE_URL=postgres://postgres:postgres@localhost:5432/internal_tool

# Better Auth. Both are required in production and optional locally.
# Generate a secret with: openssl rand -base64 32. Without one, the API makes a random
# secret at startup, so you'll need to sign in again whenever it restarts.
# BETTER_AUTH_SECRET=
# The web app's origin (browsers reach the API through it). Defaults to this locally.
BETTER_AUTH_URL=http://localhost:3000
